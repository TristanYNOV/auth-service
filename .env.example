PORT=3000
NODE_ENV=development
STRICT_ENV=false

DATABASE_URL=mongodb://auth_db:27017
DB_NAME=auth_db
JWT_SECRET=__CHANGE_ME__
JWT_EXPIRES_IN=15m
JWT_ISSUER=
JWT_AUDIENCE=
SALT=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongPassword123!
ADMIN_PSEUDO=admin

RABBITMQ_URL=amqp://app:change_me@rabbitmq:5672
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE_AUTH=auth-service.user-deletion
