        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pseudo\": \"{{pseudoUpdated}}\",\n  \"email\": \"{{emailUpdated}}\",\n  \"password\": \"{{passwordUpdated}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Users - Delete",
      "request": {
        "method": "DELETE",
