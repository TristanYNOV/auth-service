                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('refresh returns accessToken', function () { pm.expect(typeof data.accessToken).to.eql('string'); });",
                  "pm.collectionVariables.set('accessTokenAdmin', data.accessToken);"
                ]
              }
            }
          ]
        },
