{
  "info": {
    "name": "auth-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f5f340f4-52b4-4eb7-a06f-2ec22f75aa89"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const useTraefik = String(pm.environment.get('useTraefik') || 'false') === 'true';",
          "const baseUrl = useTraefik ? pm.environment.get('baseUrlTraefik') : pm.environment.get('baseUrlDirect');",
          "pm.collectionVariables.set('baseUrl', baseUrl);",
          "const requestName = pm.info.requestName || '';",
          "const isAdminRequest = requestName.startsWith('Admin -');",
          "const tokenKey = isAdminRequest ? 'accessTokenAdmin' : 'accessTokenUser';",
          "const token = pm.collectionVariables.get(tokenKey);",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('userEmail', `user_${suffix}@example.com`);",
                  "pm.collectionVariables.set('userPseudo', `user_${suffix}`);",
                  "pm.collectionVariables.set('userPassword', `StrongPass1!${suffix}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"pseudo\": \"{{userPseudo}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.text().replace(/^\"|\"$/g, '');",
                  "pm.collectionVariables.set('accessTokenUser', token);",
                  "const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('userId', payload.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me (GET)",
          "request": { "method": "GET", "url": "{{baseUrl}}/me" }
        },
        {
          "name": "Me (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pseudo\": \"{{userPseudo}}_updated\"\n}" },
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Me (DELETE)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/me" }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.text().replace(/^\"|\"$/g, '');",
                  "pm.collectionVariables.set('accessTokenAdmin', token);",
                  "const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('adminUserId', payload.sub);",
                  "pm.test('roles contains admin', function () {",
                  "  pm.expect(Array.isArray(payload.roles)).to.equal(true);",
                  "  pm.expect(payload.roles.includes('admin')).to.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Admin - List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" }
        },
        {
          "name": "Admin - Patch User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pseudo\": \"patched_by_admin\"\n}" },
            "url": "{{baseUrl}}/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin - Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin - User tries admin (expect 403)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('accessTokenUser');",
                  "if (token) { pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` }); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "userPseudo", "value": "" },
    { "key": "userPassword", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "adminUserId", "value": "" },
    { "key": "accessTokenUser", "value": "" },
    { "key": "accessTokenAdmin", "value": "" }
  ]
}
