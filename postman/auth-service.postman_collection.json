{
  "info": {
    "name": "auth-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f5f340f4-52b4-4eb7-a06f-2ec22f75aa89"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const useTraefik = String(pm.environment.get('useTraefik') || 'false') === 'true';",
          "const baseUrl = useTraefik ? pm.environment.get('baseUrlTraefik') : pm.environment.get('baseUrlDirect');",
          "pm.collectionVariables.set('baseUrl', baseUrl);",
          "const requestName = pm.info.requestName || '';",
          "const isAdminRequest = requestName.startsWith('Admin -');",
          "const tokenKey = isAdminRequest ? 'accessTokenAdmin' : 'accessTokenUser';",
          "const token = pm.collectionVariables.get(tokenKey);",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('userEmail', `user_${suffix}@example.com`);",
                  "pm.collectionVariables.set('userPseudo', `user_${suffix}`);",
                  "pm.collectionVariables.set('userPassword', `StrongPass1!${suffix}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"pseudo\": \"{{userPseudo}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const token = pm.response.text().replace(/^\"|\"$/g, '');",
                  "pm.collectionVariables.set('accessTokenUser', token);",
                  "const decodePart = (part) => JSON.parse(atob(part.replace(/-/g, '+').replace(/_/g, '/')));",
                  "const header = decodePart(token.split('.')[0]);",
                  "const payload = decodePart(token.split('.')[1]);",
                  "pm.collectionVariables.set('userId', payload.sub);",
                  "pm.test('JWT alg is HS256', function () {",
                  "  pm.expect(header.alg).to.eql('HS256');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('refresh returns accessToken', function () { pm.expect(typeof data.accessToken).to.eql('string'); });",
                  "pm.collectionVariables.set('accessTokenUser', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('logout message', function () { pm.expect(pm.response.json().message).to.eql('Logged out'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after Logout (expect 401)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Me (GET)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Me (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"{{userPseudo}}_updated\"\n}"
            },
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Me (DELETE)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/me"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const token = pm.response.text().replace(/^\"|\"$/g, '');",
                  "pm.collectionVariables.set('accessTokenAdmin', token);",
                  "const decodePart = (part) => JSON.parse(atob(part.replace(/-/g, '+').replace(/_/g, '/')));",
                  "const header = decodePart(token.split('.')[0]);",
                  "const payload = decodePart(token.split('.')[1]);",
                  "pm.collectionVariables.set('adminUserId', payload.sub);",
                  "pm.test('roles contains admin', function () {",
                  "  pm.expect(Array.isArray(payload.roles)).to.equal(true);",
                  "  pm.expect(payload.roles.includes('admin')).to.equal(true);",
                  "});",
                  "pm.test('JWT alg is HS256', function () {",
                  "  pm.expect(header.alg).to.eql('HS256');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
