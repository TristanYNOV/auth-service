              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('logout message', function () { pm.expect(pm.response.json().message).to.eql('Logged out'); });"
                ]
              }
