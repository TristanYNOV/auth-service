        {
          "name": "Admin - List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Admin - Patch User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"patched_by_admin\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin - Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin - User tries admin (expect 403)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('accessTokenUser');",
                  "if (token) { pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` }); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('error contract is stable (403)', function () {",
                  "  pm.expect(body).to.have.property('statusCode', 403);",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "  pm.expect(body).to.have.property('path');",
                  "  pm.expect(typeof body.message).to.eql('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Admin - No token (expect 401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove('Authorization');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('error contract is stable (401)', function () {",
                  "  pm.expect(body).to.have.property('statusCode', 401);",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "  pm.expect(body).to.have.property('path');",
                  "  pm.expect(typeof body.message).to.eql('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users"
          }
        }
